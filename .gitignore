# ============================================================
# Velora — git ignore rules
# ============================================================
# 原则：
#   1. 所有 . 开头的文件 / 目录都默认不跟踪 — 那是开发者本地环境
#      的私人配置（编辑器、AI 工具、IDE 缓存等），不应该污染主仓。
#   2. .gitignore 本身必须被 git 跟踪（这是仓库规则文件）。
#   3. 真正需要共享的 . 开头文件用 ! 显式 allow 回来。
# ============================================================

# ---- 所有 . 开头的文件 / 目录都忽略 ----
.*

# ---- 必须被 git 管理的例外 ----
# .gitignore 本身
!.gitignore
# VSCode 推荐的扩展清单 — 团队共享
!.vscode/extensions.json

# ---- node / 构建产物 ----
node_modules
dist
dist-ssr
*.local

# ---- IDE / OS 杂项（已由 .* 兜底，但显式列出来更可读） ----
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Rust / Tauri ----
target
gen/schemas
